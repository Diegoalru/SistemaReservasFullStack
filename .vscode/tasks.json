{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend · Spring Boot",
      "type": "shell",
      "command": "cd ${workspaceFolder}/backend && ./gradlew bootRun --args='--server.port=8081'",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Started BackendApplication.*",
          "endsPattern": "^.*Started BackendApplication.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false
      }
    },
    {
      "label": "Frontend · Angular",
      "type": "shell",
      "command": "cd ${workspaceFolder}/frontend && ng serve --host 0.0.0.0 --poll 2000",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Application bundle generated.*",
          "endsPattern": "^.*Compiled successfully.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false
      }
    },
    {
      "label": "Dev · Iniciar Backend + Frontend",
      "dependsOn": [
        "Backend · Spring Boot",
        "Frontend · Angular"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
